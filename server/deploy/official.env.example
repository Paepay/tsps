# PaeScape Official world environment.
#
# Install as /etc/paescape/official.env (system unit) or
# ~/apps/paescape-official/official.env (user unit), owned by the service
# account with mode 0600. Never commit the real file.
#
# The platform provisions the official installation from
# PLATFORM_OFFICIAL_INSTALLATION_KEY/SECRET on the website side. The same pair
# is entered here once; the world then enrolls itself and stores its own
# credential in PAESCAPE_INSTALLATION_FILE.

NODE_ENV=production

# Isolated listener. Nginx terminates TLS and proxies WSS to 127.0.0.1:43595.
WEBSOCKET_PORT=43595
TCP_PORT=43595

# Website platform and this world's permanent public endpoint.
PAESCAPE_PLATFORM_URL=https://paescape.online
PAESCAPE_PUBLIC_ENDPOINT=https://official.paescape.online

# Enrollment/installation identity. Values are issued by the platform operator.
PAESCAPE_INSTALLATION_KEY=replace-with-platform-issued-key
PAESCAPE_INSTALLATION_SECRET=replace-with-platform-issued-secret
PAESCAPE_INSTALLATION_FILE=/home/user/apps/paescape-official/data/paescape-installation.json

# Keep the official world's player and account files out of any community
# world's data directory. Back these paths up before an update.
PLAYER_SAVE_DATABASE_PATH=/home/user/apps/paescape-official/data/saves/players.sqlite
LEGACY_PLAYER_SAVE_DIRECTORY=/home/user/apps/paescape-official/data/saves/characters
TSPS_ACCOUNTS_FILE=/home/user/apps/paescape-official/data/accounts.json
TSPS_DISPLAY_NAMES_FILE=/home/user/apps/paescape-official/data/display-names.json

# Runtime profile for a public 24/7 service.
LOG_LEVELS=info,warn,error
BOT_RUNTIME_EVENT_LOGGING=0
BOT_RUNTIME_TELEMETRY_ENABLED=0
BOT_TASK_PROFILER_ENABLED=0
TASK_SLOW_WARN_ENABLED=0
PROJECTILE_DEBUG=0
MAGIC_CAST_DEBUG=0
